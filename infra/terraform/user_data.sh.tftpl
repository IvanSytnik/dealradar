#!/bin/bash
# First boot of the DealRadar instance (Amazon Linux 2023, arm64).
# Rendered by Terraform templatefile(): a doubled dollar sign is a literal shell variable.
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker

# 1 GiB RAM: a small swap file keeps image pulls and container restarts from running out of memory
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=1024
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap defaults 0 0' >> /etc/fstab
fi

mkdir -p /opt/dealradar/data
chown 1000:1000 /opt/dealradar/data   # the container runs as user "node" (uid 1000)

cat > /opt/dealradar/run.sh <<'SCRIPT'
#!/bin/bash
# Pull an image tag and (re)start the bot. Called by the deploy pipeline through SSM Run Command.
set -euo pipefail

TAG="$${1:-latest}"
REGION="${region}"
REGISTRY="${registry}"
IMAGE="$${REGISTRY}/${repository}:$${TAG}"
ENV_FILE=/opt/dealradar/.env

# Secrets live in SSM Parameter Store under ${param_prefix} (SecureString), never in the image or in git
umask 077
aws ssm get-parameters-by-path --region "$${REGION}" --path "${param_prefix}" --with-decryption \
  --query 'Parameters[*].[Name,Value]' --output text \
  | while IFS=$'\t' read -r name value; do printf '%s=%s\n' "$${name##*/}" "$${value}"; done > "$${ENV_FILE}"

if ! grep -q '^TELEGRAM_BOT_TOKEN=' "$${ENV_FILE}"; then
  echo "TELEGRAM_BOT_TOKEN is missing in SSM ${param_prefix}" >&2
  exit 1
fi

aws ecr get-login-password --region "$${REGION}" | docker login --username AWS --password-stdin "$${REGISTRY}"
docker pull "$${IMAGE}"

# Stop the old container first: Telegram allows only one long-polling consumer per bot
docker rm -f dealradar 2>/dev/null || true
docker run -d --name dealradar --restart unless-stopped \
  --env-file "$${ENV_FILE}" \
  -v /opt/dealradar/data:/app/data \
  --memory 600m \
  --log-driver awslogs \
  --log-opt awslogs-region="$${REGION}" \
  --log-opt awslogs-group="${log_group}" \
  --log-opt awslogs-stream=bot \
  "$${IMAGE}"

docker image prune -f >/dev/null
echo "deployed $${IMAGE}"
SCRIPT
chmod 700 /opt/dealradar/run.sh
