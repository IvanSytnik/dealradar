# Required: token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: without a key the bot works on rules only (no auto-profile, no deal score)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Your Telegram user id (from @userinfobot), comma-separated. Unlocks /stats and /grant
ADMIN_IDS=

DB_PATH=data/dealradar.db

# Politeness towards marketplaces: min ms between two requests to the same host
HOST_MIN_GAP_MS=2000
# How often the scheduler looks for due watches
TICK_SECONDS=15

# true = every new user gets Pro (private deployment for you and friends)
EVERYONE_PRO=false

# debug | info | warn | error
LOG_LEVEL=info

# Contact shown in /privacy for data questions (e-mail or @username)
CONTACT=

# Optional: publish /scan reports to S3 + CloudFront so they open in a real browser (see infra/terraform).
# Only used when both REPORTS_BUCKET and REPORTS_BASE_URL are set; otherwise the report is sent as a file.
# AWS credentials come from the default AWS SDK chain (on EC2: the instance role).
REPORTS_BUCKET=
REPORTS_BASE_URL=
# Region of the bucket; falls back to AWS_REGION, then eu-north-1
REPORTS_REGION=
